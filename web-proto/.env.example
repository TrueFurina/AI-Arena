# 复制为 .env 并填入你的 key（.env 不提交）

# 智谱 AI (Z.AI)  -> 对应模型前缀 zai/
ZAI_API_KEY=你的key

# Moonshot (Kimi) -> moonshot/
MOONSHOT_API_KEY=你的key

# DeepSeek -> deepseek/
DEEPSEEK_API_KEY=你的key

# OpenAI -> openai/
OPENAI_API_KEY=你的key

# 通义千问 -> qwen/
DASHSCOPE_API_KEY=你的key

# Anthropic -> anthropic/
ANTHROPIC_API_KEY=你的key

# Google Gemini -> gemini/
GOOGLE_API_KEY=你的key

# 自定义免费端点 ashbwin（OpenAI 兼容）
ASHBWIN_API_BASE=http://203.135.99.69:11000/v1
ASHBWIN_API_KEY=你的key
ASHBWIN_MODEL=ashbwin
