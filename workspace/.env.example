# AI-Arena 环境变量模板
# 用法：复制为同目录下的 .env 并填入真实值（.env 不入库，规则 2）
# 任何代码里都不要写死 key，统一从这里读

# ===== 模型供应商 API Key（按需填写，用哪个填哪个）=====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=            # DeepSeek      litellm 模型名: deepseek/deepseek-chat
DASHSCOPE_API_KEY=           # 通义千问 Qwen  litellm 模型名: qwen/qwen-plus
MOONSHOT_API_KEY=            # Kimi 月之暗面  litellm 模型名: moonshot/moonshot-v1-8k

# ===== litellm / 运行配置（可选）=====
LITELLM_LOG_LEVEL=INFO
# 如需代理（如无法直连海外端点）：
# LITELLM_PROXY_URL=http://127.0.0.1:8000

# ===== 评测与日志（可选）=====
ARENA_LOG_DIR=logs
ARENA_REPORT_DIR=analysis
ARENA_MAX_TURNS=20
